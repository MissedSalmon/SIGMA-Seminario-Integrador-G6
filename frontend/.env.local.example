# Copiar este archivo como frontend/.env.local y completar los valores.
# El archivo .env.local NO se sube al repositorio.
#
# En Next.js, todo lo que empieza con NEXT_PUBLIC_ queda visible en el navegador.
# Por eso aca SOLO van claves publicas.

# Direccion de la API del backend
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Datos publicos de Supabase
# Se sacan de: panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA poner aca la SERVICE_ROLE_KEY. Esa va solo en backend/.env

# Copiar este archivo como backend/.env y completar los valores.
# El archivo .env NO se sube al repositorio.

# Puerto donde escucha la API
PORT=4000

# Entorno: development | production
NODE_ENV=development

# Datos de Supabase
# Se sacan de: panel de Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ATENCION: esta clave saltea todas las reglas de seguridad de la base.
# Va SOLO en el backend. Nunca en el frontend, nunca en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Direcciones del frontend que pueden llamar a esta API.
# Varias se separan con coma.
CORS_ORIGIN=http://localhost:3000

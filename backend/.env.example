# Copiar este archivo como backend/.env y completar los valores.
# El archivo .env NO se sube al repositorio.

# Panel de Supabase -> Project Settings -> API
SUPABASE_URL=https://agayydinmimmqoyuybbi.supabase.co
# La SERVICE_ROLE_KEY es secreta: nunca se comparte por un canal publico.
# Se saca del mismo panel, seccion "service_role" (no la "anon"/"publishable").
SUPABASE_SERVICE_ROLE_KEY=

# Puerto donde escucha esta API.
PORT=4000

# Origenes del frontend que tienen permiso para llamar a esta API.
# Varios separados por coma: "http://localhost:3000,https://sigma.vercel.app"
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=supersecret123

# Planes preventivos: la OT se genera estos días antes de la fecha del activo,
# y la generación corre todos los días a esta hora de Argentina (0 a 23).
PLANES_DIAS_ANTICIPACION=7
PLANES_HORA_GENERACION=6
